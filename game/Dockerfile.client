# Client Dockerfile - Multi-stage build for React + Vite client
FROM node:20-alpine AS builder

# Build arguments for server connection
ARG VITE_SERVER_HOST=localhost
ARG VITE_SERVER_PORT=8443
ARG VITE_WS_PROTOCOL=wss
ARG VITE_SERVER_PATH=/ws
ARG VITE_BASE_PATH=/game-engine/

WORKDIR /app

# Copy package files for all workspaces
COPY package.json package-lock.json* ./
COPY common/package.json ./common/
COPY client/package.json ./client/

# Install all dependencies
RUN npm install

# Copy source code
COPY common/ ./common/
COPY client/ ./client/

# Build common package first
WORKDIR /app/common
RUN npx tsc --skipLibCheck

# Build client with Vite
WORKDIR /app/client
RUN VITE_SERVER_HOST=${VITE_SERVER_HOST} VITE_SERVER_PORT=${VITE_SERVER_PORT} VITE_WS_PROTOCOL=${VITE_WS_PROTOCOL} VITE_SERVER_PATH=${VITE_SERVER_PATH} VITE_BASE_PATH=${VITE_BASE_PATH} npm run build

# Production stage - nginx to serve static files
FROM nginx:alpine AS production

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built client files
COPY --from=builder /app/client/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
