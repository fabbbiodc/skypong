# Server Dockerfile - Multi-stage build for Colyseus game server
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files for all workspaces
COPY package.json package-lock.json* ./
COPY common/package.json ./common/
COPY server/package.json ./server/
COPY client/package.json ./client/

# Install all dependencies (including devDependencies for build)
RUN npm install

# Copy source code
COPY common/ ./common/
COPY server/ ./server/

# Build common package first
WORKDIR /app/common
RUN npx tsc --skipLibCheck

# Build server
WORKDIR /app/server
RUN npx tsc --skipLibCheck

# Debug: show what was built and where
RUN echo "=== Contents of /app/server/dist ===" && find /app/server/dist -name "*.js" 2>/dev/null || echo "No files in /app/server/dist"
RUN echo "=== Contents of /app/dist ===" && find /app/dist -name "*.js" 2>/dev/null || echo "No files in /app/dist"

# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
COPY common/package.json ./common/
COPY server/package.json ./server/

# Install production dependencies only
RUN npm install --omit=dev --workspace=server --workspace=common

# Copy built files from builder
COPY --from=builder /app/common/ ./common/
COPY --from=builder /app/server/dist/ ./dist/

# Expose game server port
EXPOSE 2567

# Start the server
CMD ["node", "dist/server/src_serv/index.js"]
