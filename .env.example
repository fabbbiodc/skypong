UID=1000
GID=1000

# ─────────────────────────────────────────
# Grafana authentication
# ─────────────────────────────────────────

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JWT Secret (genera uno con: openssl rand -hex 64)
JWT_SECRET=

# Database
DATABASE_URL=

# Encryption Key
ENCRYPTION_KEY=

# ─────────────────────────────────────────
# SERVICE TOKEN FOR INTERNAL COMMUNICATION
# ─────────────────────────────────────────

SERVICE_TOKEN=changeme

# ─────────────────────────────────────────
# SERVICE URLS
# ─────────────────────────────────────────

AUTH_SERVICE_URL=http://auth-service:8081
PROFILE_SERVICE_URL=http://profile-service:5000
STATS_SERVICE_URL=http://statistics-service:6000

# ─────────────────────────────────────────
# SQLITE WEB for demonstration purpose only
# ─────────────────────────────────────────

SQLITE_WEB_PASSWORD=demo123
